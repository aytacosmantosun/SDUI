root = true

[*]
trim_trailing_whitespace = false
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120

csharpier_print_width = 120
dotnet_diagnostic.IDE1006.severity = none # naming conventions
# .NET 9+ WinForms analyzer about how the Visual Studio designer would serialize custom control
# properties. It does not affect runtime behavior; the Designer files are kept by hand.
dotnet_diagnostic.WFO1000.severity = none
